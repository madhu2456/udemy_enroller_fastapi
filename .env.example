# Application Configuration
APP_NAME=Udemy Course Enroller
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-string-in-production
COOKIE_SECURE=false

# Cookie encryption key — must be a valid Fernet key (32 bytes base64-encoded).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in server mode — the app will not start without a valid Fernet key. Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is the MASTER key for per-session cookie envelopes (F-ENRL-C01): each
# login derives a session-specific key via HKDF-SHA256 (master key + per-session
# salt stored in users.cookies_salt). Rotating this key invalidates ALL stored
# cookie blobs — users must log in again.
COOKIE_ENCRYPTION_KEY=

# Legacy (unsalted) cookie blob decrypt gate (F-ENRL-C01). Default: ON for
# local/dev (with a warning), OFF for server/production — legacy blobs (old
# master-key Fernet envelopes or plaintext) yield None -> 401 and the user must
# log in again (fail-closed). After running
#   python scripts/migrate_cookies_per_session.py --apply --backup-verified
# keep this OFF in production.
# ALLOW_LEGACY_COOKIE_DECRYPT=1

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
# Production public URL (canonical, no www): https://udemyenroller.madhudadi.in
# www.udemyenroller.madhudadi.in is served by the nginx catch-all once the Cloudflare CNAME (www → apex, Proxied) exists; canonicals stay apex.
DEPLOYMENT_ENV=local  # "local" or "server" (server=stricter rate limits, secure cookies, cookie-only login on hosted demo)
# ALLOW_USER_PROXY — whether the per-user "Proxy URL" setting is honored for
# enrollment/scraping traffic. Default true in local mode. Server mode
# HARD-DISABLES it (a hosted deployment never routes outbound traffic through
# user-chosen endpoints); the value is stored but ignored. Admin-configured
# PROXIES (coupon checker) are unaffected.
# ALLOW_USER_PROXY=true
# PUBLIC_BASE_URL — anchors the login-CSRF origin gate to the public netloc
# when set (instead of request.base_url). Required behind Cloudflare Flexible
# SSL, where the app sees http while browsers send https Origins. Recommended
# production value: https://udemyenroller.madhudadi.in
# PUBLIC_BASE_URL=https://udemyenroller.madhudadi.in

# Max concurrent app sessions per user (oldest revoked on new login). 0 = unlimited.
MAX_SESSIONS_PER_USER=3

# CORS Configuration
# JSON array of allowed origins (development: http://localhost:3000, http://localhost:8000)
# Production (server): CORS_ORIGINS='["https://udemyenroller.madhudadi.in"]'
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Trusted reverse proxies — JSON list (pydantic-settings v2), default ["127.0.0.1","::1"].
# In Docker the entrypoint (docker-entrypoint.sh) resolves the compose bridge gateway
# and exports TRUSTED_PROXY_IPS with it included — no manual setting needed there.
# Set explicitly only when routing through additional trusted hops. A malformed JSON
# value fails startup (fail-closed):
# TRUSTED_PROXY_IPS='["127.0.0.1","::1"]'

# Database (SQLite for simplicity, can be changed to PostgreSQL)
DATABASE_URL=sqlite:///./udemy_enroller.db
# Keep false when using Alembic migrations; true is only for legacy bootstrap.
AUTO_CREATE_TABLES=false

# Public /udemycoupons catalog path. Leave empty for ./public_deals.json (local).
# Docker compose sets this to /app/data/public_deals.json so checker updates
# survive container rebuilds (shared data volume).
# PUBLIC_DEALS_PATH=/app/data/public_deals.json

# Coupon checker loop (docker compose service: coupon-checker)
# COUPON_CHECKER_INTERVAL_SECONDS=7200
# COUPON_CHECKER_RUN_ON_START=true
# COUPON_CHECKER_LOG_LEVEL=INFO
# Auto-import latest coupons each checker cycle (scrape coupon sources -> merge
# fresh deals -> validate). Default true. NOTE: to control this from .env in
# Docker, the compose coupon-checker service must list the var in its
# environment block (env passthrough is explicit).
# CHECKER_SCRAPE_ON_CYCLE=true
# CHECKER_SCRAPE_MAX_SOURCES=0
#   0 or ≥ registry size = all keys. Execution order: appended sources
#   (Courson, CouponScorpion) first, then Couponami, then the rest
#   of the frozen 10. 0 < N < size → at most N; cap slots go to appended keys
#   first, then Couponami, then frozen prefix front. N=2 is appended-only.
#   N=3 is the two appended sources + Couponami. Leftover N=11 omits
#   iDownloadCoupon (omitted names are logged). Compose default is 0.
# Verification mode (pure validation cycle, skips ~45-min scrape): set CHECKER_SCRAPE_ON_CYCLE=false,
# then docker compose up -d coupon-checker; revert to true after.

# For PostgreSQL on Digital Ocean:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Logging Configuration
# LOG_LEVEL: WARNING (default), INFO (more verbose), DEBUG (most verbose)
# SECURITY: Setting LOG_LEVEL to INFO or DEBUG will expose sensitive data in logs.
# Only use higher verbosity in development. Production should remain at WARNING.
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log
LOG_FORMAT=json  # Options: "json" or "text"

# Google Search Console verification (set after creating a GSC property)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (set after creating a Bing property)
BING_SITE_VERIFICATION=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
GTM_CONTAINER_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Used for direct GA4 tracking — works independently of GTM
GA4_MEASUREMENT_ID=

# Redis (optional, for task queue)
REDIS_URL=redis://localhost:6379/0

# Upstash Redis REST (optional) — enables shared rate-limit buckets via Upstash
# Redis for the async limiter paths (login). RateLimiter.is_allowed_redis() is
# active only when BOTH are set; otherwise it fails open to per-instance
# in-memory limiting. Sync-only callers (analytics, CSP, coupons, auth-status)
# remain in-memory. Get these from the Upstash console (REST URL + REST token).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Pre-configured Udemy credentials
# SECURITY: Storing passwords in environment files is insecure.
# Use Cookie Login (access_token, client_id, csrftoken) instead.
# See /guides for instructions on extracting session cookies safely.
UDEMY_EMAIL=
UDEMY_PASSWORD=

# Scraper settings
MAX_SCRAPER_WORKERS=5
SCRAPER_SITE_TIMEOUT_SECONDS=1800
SCRAPER_RUN_TIMEOUT_SECONDS=2700
SCRAPER_TIMEOUT=30

# Optional: Comma-separated list of proxies for network flexibility
# Format: http://user:pass@host:port,socks5://user:pass@host:port
# NOTE: Use proxies only for legitimate network requirements (e.g., corporate
# networks, geographic access). Do not use for rate-limit evasion or IP rotation.
PROXIES=

# Stuck-run recovery (F-ENRL-O01): the in-process sweeper marks enrollment runs
# whose last heartbeat is older than STALE_RUN_TIMEOUT_MINUTES as failed, and
# runs every STALE_RUN_SWEEP_SECONDS.
STALE_RUN_TIMEOUT_MINUTES=15
STALE_RUN_SWEEP_SECONDS=60

# Backup encryption (F235): when set, scripts/backup_sqlite.sh writes
# encrypted *.db.enc backups (openssl AES-256-CBC, pbkdf2). When unset,
# plaintext backups are REFUSED unless the script is invoked with
# --allow-plaintext. Duplicate the key in your password manager BEFORE
# enabling encryption — key loss = backup loss. Never log or commit the key.
# BACKUP_ENCRYPTION_KEY=

# Minimal operational alerting (F230): when set, enrollment task failures and
# stuck-run sweeper recoveries POST a JSON alert to this webhook URL.
# Default OFF (empty) — no behavior change. The URL is never logged.
# ALERT_WEBHOOK_URL=
